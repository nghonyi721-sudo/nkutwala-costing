# Copy this file to .env and fill in the real values.
# This file IS committed to Git - never put real emails or passwords here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Test users for the Rate Wall attack test (npm run test:rls).
# Not VITE_ variables, so they are never sent to the browser.
TEST_SITE_EMAIL=site-manager-test@example.com
TEST_SITE_PASSWORD=your-site-manager-test-password
TEST_OWNER_EMAIL=owner-test@example.com
TEST_OWNER_PASSWORD=your-owner-test-password

# A second site manager, to prove managers can't see each other's reports.
TEST_SITE2_EMAIL=site-manager-2-test@example.com
TEST_SITE2_PASSWORD=your-second-site-manager-test-password

# A system admin, to prove only admins can reverse an approved receipt and
# that nobody can approve their own receipt.
TEST_ADMIN_EMAIL=admin-test@example.com
TEST_ADMIN_PASSWORD=your-admin-test-password
